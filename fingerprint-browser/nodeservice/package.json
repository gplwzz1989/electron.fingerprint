{
  "name": "@yixiaoer/platform-service",
  "version": "4.5.13",
  "files": [
    "dist",
    "types",
    "lib",
    "src/media-platform/ximalaya/_sign",
    "src/media-platform/pipixia/assets"
  ],
  "main": "./lib/index.umd.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.coozf.com/repository/npm-release/"
  },
  "scripts": {
    "clean": "npx rimraf ./dist ./types ./node_modules",
    "build": "ncc build ./src/index.ts -o ./dist -m",
    "build:lib": "vite build --mode lib",
    "build:all": "npm run build && npm run build:lib",
    "build:all_publish": "npm run build && npm run build:lib && npm publish",
    "build:type": "tsc --declaration --emitDeclarationOnly",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run clean && npm install && npm run build",
    "republish": "npm unpublish --force && npm publish",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx --ignore-path .gitignore .",
    "prepare": "husky install",
    "generate:platform-schema": "node scripts/generate-complete-openapi.js",
    "build_publishTaskForm": "node scripts/generate-complete-openapi.js ./src/platform-body platform-body-complete-openapi",
    "build_contentlist": "node scripts/generate-content-list-openapi.js ./src/platform-body/content-list content-list-item-openapi",
    "build_accountover": "node scripts/generate-content-list-openapi.js ./src/platform-body/accouont-overview account-overview-openapi"
  },
  "devDependencies": {
    "@types/node": "20.6.3",
    "@types/pako": "2.0.3",
    "@types/xmldom": "0.1.34",
    "@typescript-eslint/eslint-plugin": "6.4.0",
    "@typescript-eslint/parser": "6.4.0",
    "@vercel/ncc": "0.38.2",
    "@vitest/coverage-v8": "3.1.3",
    "@vitest/ui": "3.1.3",
    "aws4-axios": "3.3.0",
    "axios": "1.5.0",
    "axios-retry": "3.8.0",
    "crc": "4.3.2",
    "electron": "33.0.2",
    "eslint": "8.49.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "husky": "8.0.3",
    "msw": "1.3.2",
    "prettier": "3.0.1",
    "socket.io-client": "4.7.5",
    "swagger-jsdoc": "6.2.8",
    "typescript": "5.1.6",
    "uuid": "9.0.1",
    "vite": "5.4.11",
    "vite-plugin-node-polyfills": "0.22.0",
    "vitest": "3.1.3",
    "xml-writer": "1.7.0",
    "xmldom": "0.6.0",
    "xpath": "0.0.32"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": false
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.8",
    "aws4-axios": "3.3.0",
    "axios-retry": "3.8.0",
    "dayjs": "1.11.13",
    "form-data": "4.0.0",
    "https-proxy-agent": "7.0.6",
    "long": "5.3.2",
    "pako": "2.1.0",
    "protobufjs": "7.5.4",
    "request-promise": "4.2.6",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "socks-proxy-agent": "8.0.5",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0",
    "ws": "8.18.0",
    "xml-writer": "1.7.0"
  },
  "overrides": {
    "@aws-sdk/core": "3.686.0",
    "@aws-sdk/client-sts": "3.716.0",
    "ip-address": "10.1.1"
  }
}
