    initMock(server);

    test('获取用户信息', async () => {
      // act
      const result = await getCreatorUserInfo('cookie');

      // assets
      expect(result).not.toBeUndefined();
      expect(result).not.toBeNull();
      expect(result.douyin_user_verify_info.avatar_url).toBe(
        'https://p3.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-i-0813c001_b3f6b608dcb143eeb1fc0e547d5fc799.jpeg?from=2956013662',
      );
      expect(result.douyin_user_verify_info.douyin_unique_id).toBe('376623504');
      expect(result.douyin_user_verify_info.is_super_tag_user).toBe(false);
      expect(result.douyin_user_verify_info.nick_name).toBe('Midnight');
      expect(result.douyin_user_verify_info.sync_to_xigua).toBe(true);
      expect(result.douyin_user_verify_info.teen_model).toBe(false);
      expect(result.douyin_user_verify_info.total_favorited).toBe(339);
      expect(result.is_commerce_user).toBe(false);
      expect(result.user_profile).not.toBeNull();
      expect(result.user_profile.nick_name).toBe('Midnight');
      expect(result.user_profile.unique_id).toBe('376623504');
    });
  });

