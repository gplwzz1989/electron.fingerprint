import { getCreatorUserInfo, getMediaUserInfo } from '@/media-platform/douyin/douyin-user.service';
import { initMock } from '@@/mock/mock';
import { rest } from 'msw';
import { setupServer } from 'msw/node';
import { describe, expect, test, it } from 'vitest';
import { getCookie } from './douyin.test';
import {
  getDouyinLocationType,
  getDouyinShopOverLimit,
  getDouyinUserStatus,
} from '../../../src/media-platform/douyin/douyin-user';

if (false) {
  it('获取用户状态', async () => {
    const cookie = getCookie();
    const result = await getDouyinUserStatus(cookie);
    console.log(result);
    expect(result.code).toBe(0);
  });

  it('获取用户是否有挂车权限', async () => {
    const cookie = getCookie();
    const result = await getDouyinShopOverLimit(cookie);
    console.log(result);
    expect(result.code).toBe(0);
  });

  it('获取用户支持的地理位置类型', async () => {
    const cookie = getCookie();
    const result = await getDouyinLocationType(cookie);
    console.log(result);
    expect(result.code).toBe(0);
  });
}

