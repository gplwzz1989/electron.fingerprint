{
  "compilerOptions": {
    "baseUrl": "./",
    // 生成声明文件
    "declaration": true,

    "esModuleInterop": true,
    // 确保可以安全地转译每个文件，而无需依赖其他导入
    "isolatedModules": true,
    "jsx": "preserve",
    // 设置库
    "lib": ["ESNext", "DOM", "ScriptHost"],
    "module": "CommonJS",
    "target": "ES6",

    "moduleResolution": "Node",
    // 为具有隐含“any”类型的表达式和声明启用错误报告
    "noImplicitAny": false,
    // 路径映射
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./test/*"]
    },
    // 启用导入 .json 文件
    "resolveJsonModule": true,
    // 跳过类型检查所有 .d.ts 文件。
    "skipLibCheck": true,
    // 启用所有严格的类型检查选项。
    "strict": true,
    // 使用符合 ECMAScript 标准的类字段。
    "useDefineForClassFields": true,
    // 当模块没有默认导出时，允许“从 y 导入 x”。
    "allowSyntheticDefaultImports": true,
    // 删除注释
    "removeComments": false,
    // 检查只声明、未使用的局部变量(只提示不报错)
    "noUnusedLocals": false,

    "types": ["vitest/importMeta"],

    "outDir": "./dist/tmp"
  },
  "include": ["src"]
}
