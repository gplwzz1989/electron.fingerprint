 #include "base/containers/span.h"
@@ -109,6 +114,103 @@ void CopyPixelValue(const base::span<uint8_t> from_pixel,
   writer.Write(from_pixel.first<kChannelsPerPixel>());
 }
 
+void NoisePixelsEdgeAwareImpl(const NoiseHash& token_hash,
+                              base::span<uint8_t> pixels,
+                              const int width,
+                              const int height) {
+  // 探针尺寸保护：真实指纹采集需绘制长文本（高度通常在 20px~150px 间）。
+  // PixelScan 70x5 等微小尺寸探针画布直接跳过，保持 100% 原始像素。
+  if (width < 16 || height < 16 || (static_cast<size_t>(width) * height) < 512u) {
+    return;
+  }
+
+  const size_t row_size = static_cast<size_t>(width) * kChannelsPerPixel;
+  std::vector<uint8_t> row1(row_size);
+  std::vector<uint8_t> row2(row_size);
+  std::vector<uint8_t> row3(row_size);
+  base::span<uint8_t> previous_row(row1);
+  base::span<uint8_t> current_row(row2);
+  base::span<uint8_t> next_row(row3);
+  previous_row.copy_from(pixels.first(row_size));
+  current_row.copy_from(pixels.subspan(row_size, row_size));
+  next_row.copy_from(pixels.subspan(row_size * 2u, row_size));
+
+  for (int y = 1; y < height - 1; ++y) {
+    const size_t row_offset = static_cast<size_t>(y) * row_size;
+    for (int x = 1; x < width - 1; ++x) {
+      const size_t pixel_offset =
+          static_cast<size_t>(x) * kChannelsPerPixel;
+      if (current_row[pixel_offset + 3u] == 0u) {
+        continue;
+      }
+
+      // 单色平坦区与纯色硬直阶跃拼合边界保护：
+      // 检查当前像素与 4 邻域（左、右、上、下）的同色邻居数量。
+      // 若同色邻居数 >= 2，说明处于单色块内部或纯色块拼合边缘，保持 0 扰动。
+      int same_color_neighbors = 0;
+      const size_t neighbor_offsets[4] = {
+          pixel_offset - kChannelsPerPixel,
+          pixel_offset + kChannelsPerPixel,
+          pixel_offset,
+          pixel_offset
+      };
+
+      for (int dir = 0; dir < 4; ++dir) {
+        const uint8_t* neighbor_data = nullptr;
+        if (dir < 2) {
+          neighbor_data = &current_row[neighbor_offsets[dir]];
+        } else if (dir == 2) {
+          neighbor_data = &previous_row[neighbor_offsets[dir]];
+        } else {
+          neighbor_data = &next_row[neighbor_offsets[dir]];
+        }
+
+        int diff = 0;
+        for (int ch = 0; ch < 3; ++ch) {
+          diff += std::abs(static_cast<int>(current_row[pixel_offset + ch]) -
+                           static_cast<int>(neighbor_data[ch]));
+        }
+        if (diff == 0) {
+          same_color_neighbors++;
+        }
+      }
+
+      if (same_color_neighbors >= 2) {
+        continue;
+      }
+
+      int horizontal_gradient = 0;
+      int vertical_gradient = 0;
+      for (int channel = 0; channel < 3; ++channel) {
+        const size_t channel_offset = pixel_offset + channel;
+        horizontal_gradient += std::abs(
+            static_cast<int>(current_row[channel_offset - kChannelsPerPixel]) -
+            static_cast<int>(current_row[channel_offset + kChannelsPerPixel]));
+        vertical_gradient += std::abs(
+            static_cast<int>(previous_row[channel_offset]) -
+            static_cast<int>(next_row[channel_offset]));
+      }
+      if (horizontal_gradient + vertical_gradient < 6) {
+        continue;
+      }
+
+      // 仅在真实抗锯齿渐变带施加基于 Session 种子的微小扰动
+      NoiseHash pixel_hash = token_hash;
+      const uint64_t coordinate =
+          (static_cast<uint64_t>(y) << 32u) | static_cast<uint32_t>(x);
+      pixel_hash.Update(coordinate);
+      for (int channel = 0; channel < 3; ++channel) {
+        const int delta = pixel_hash.GetValueBelow(3) - 1;
+        const size_t channel_offset = row_offset + pixel_offset + channel;
+        const int value = static_cast<int>(current_row[pixel_offset + channel]) +
+                          delta;
+        pixels[channel_offset] =
+            static_cast<uint8_t>(std::clamp(value, 0, 255));
+      }
+    }
+
+    if (y + 1 < height - 1) {
+      std::swap(previous_row, current_row);
+      std::swap(current_row, next_row);
+      next_row.copy_from(
+          pixels.subspan(static_cast<size_t>(y + 2) * row_size, row_size));
+    }
+  }
+}
 }  // namespace
 
 void NoisePixels(const NoiseHash& token_hash,
@@ -165,4 +232,20 @@ void NoisePixels(const NoiseHash& token_hash,
   }
 }
 
+void NoisePixelsEdgeAware(const NoiseHash& token_hash,
+                          base::span<uint8_t> pixels,
+                          const int width,
+                          const int height) {
+  CHECK_GE(width, 0);
+  CHECK_GE(height, 0);
+  const size_t expected_size = static_cast<size_t>(width) *
+                               static_cast<size_t>(height) *
+                               kChannelsPerPixel;
+  CHECK_EQ(pixels.size(), expected_size);
+  if (width < 16 || height < 16) {
+    return;
+  }
+  NoisePixelsEdgeAwareImpl(token_hash, pixels, width, height);
+}
+
 }  // namespace blink
