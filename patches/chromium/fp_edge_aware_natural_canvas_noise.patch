+TEST_F(NoiseHelperTest, EdgeAwareNoisePixelsOnlyPerturbsEdges) {
+  constexpr int width = 16;
+  constexpr int height = 16;
+  constexpr size_t channels_per_pixel = 4u;
+  const uint64_t token = 0x01234678901234567;
+  const auto token_hash = NoiseHash(token, "https://a.test");
+
+  std::vector<uint8_t> flat_pixels(width * height * channels_per_pixel, 50u);
+  const std::vector<uint8_t> original_flat_pixels = flat_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(flat_pixels), width, height);
+  EXPECT_EQ(flat_pixels, original_flat_pixels);
+
+  std::vector<uint8_t> original_pixels(width * height * channels_per_pixel);
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const size_t offset = (y * width + x) * channels_per_pixel;
+      const uint8_t value = x < width / 2 ? 100u : 160u;
+      std::fill_n(original_pixels.begin() + offset, 3u, value);
+      original_pixels[offset + 3u] = 255u;
+    }
+  }
+
+  std::vector<uint8_t> noised_pixels = original_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(noised_pixels), width, height);
+  EXPECT_NE(noised_pixels, original_pixels);
+
+  bool changed = false;
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const size_t offset = (y * width + x) * channels_per_pixel;
+      EXPECT_EQ(noised_pixels[offset + 3u], original_pixels[offset + 3u]);
+      for (size_t channel = 0; channel < 3u; ++channel) {
+        const int delta = static_cast<int>(noised_pixels[offset + channel]) -
+                          static_cast<int>(original_pixels[offset + channel]);
+        EXPECT_GE(delta, -1);
+        EXPECT_LE(delta, 1);
+        if (delta != 0) {
+          changed = true;
+          EXPECT_GE(x, width / 2 - 1);
+          EXPECT_LE(x, width / 2);
+          EXPECT_GT(y, 0);
+          EXPECT_LT(y, height - 1);
+        }
+      }
+    }
+  }
+  EXPECT_TRUE(changed);
+
+  std::vector<uint8_t> repeated_pixels = original_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(repeated_pixels), width, height);
+  EXPECT_EQ(noised_pixels, repeated_pixels);
+
+  std::vector<uint8_t> other_session_pixels = original_pixels;
+  const auto other_session_hash = NoiseHash(token, "https://b.test");
+  NoisePixelsEdgeAware(other_session_hash, base::span<uint8_t>(other_session_pixels), width, height);
+  EXPECT_NE(noised_pixels, other_session_pixels);
+
+  std::vector<uint8_t> transparent_pixels = original_pixels;
+  for (size_t offset = 3u; offset < transparent_pixels.size(); offset += 4u) {
+    transparent_pixels[offset] = 0u;
+  }
+  const std::vector<uint8_t> original_transparent_pixels = transparent_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(transparent_pixels), width, height);
+  EXPECT_EQ(transparent_pixels, original_transparent_pixels);
+}
 TEST_F(NoiseHelperTest, NoisePixelsAllSameValue) {
   const int width = 100;
   const int height = 100;
