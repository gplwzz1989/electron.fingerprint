+// 仅对真实抗锯齿边缘区域添加基于 Session 种子的稳定像素扰动，硬直阶跃与微小探针不加噪。
+CORE_EXPORT void NoisePixelsEdgeAware(const NoiseHash& token_hash,
+                                      base::span<uint8_t> pixels,
+                                      const int width,
+                                      const int height);
+
 }  // namespace blink
 
 #endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_NOISE_HELPER_H_
