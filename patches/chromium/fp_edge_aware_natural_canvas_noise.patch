+TEST_F(NoiseHelperTest, EdgeAwareNoisePixelsOnlyPerturbsAntialiasingEdges) {
+  constexpr int width = 32;
+  constexpr int height = 32;
+  constexpr size_t channels_per_pixel = 4u;
+  const uint64_t token = 0x01234678901234567;
+  const auto token_hash = NoiseHash(token, "https://a.test");
+
+  // 1. 平坦纯色画布：必须 100% 保持不变
+  std::vector<uint8_t> flat_pixels(width * height * channels_per_pixel, 50u);
+  const std::vector<uint8_t> original_flat_pixels = flat_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(flat_pixels), width, height);
+  EXPECT_EQ(flat_pixels, original_flat_pixels);
+
+  // 2. 纯色块垂直硬阶跃硬直拼合边界（如 PixelScan 14 色块探针）：必须 100% 保持不变
+  std::vector<uint8_t> step_pixels(width * height * channels_per_pixel);
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const size_t offset = (y * width + x) * channels_per_pixel;
+      const uint8_t value = x < width / 2 ? 100u : 160u;
+      std::fill_n(step_pixels.begin() + offset, 3u, value);
+      step_pixels[offset + 3u] = 255u;
+    }
+  }
+  const std::vector<uint8_t> original_step_pixels = step_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(step_pixels), width, height);
+  EXPECT_EQ(step_pixels, original_step_pixels);
+
+  // 3. 具有渐变过渡斜率的真实抗锯齿边缘：必须受到确定性微扰以形成独一无二指纹
+  std::vector<uint8_t> aa_pixels(width * height * channels_per_pixel, 255u);
+  for (int y = 8; y < 24; ++y) {
+    for (int x = 8; x < 24; ++x) {
+      const size_t offset = (y * width + x) * channels_per_pixel;
+      const int dist = std::abs(x - 16);
+      uint8_t val = 0u;
+      if (dist == 0) val = 0u;
+      else if (dist == 1) val = 80u;
+      else if (dist == 2) val = 180u;
+      else val = 255u;
+      std::fill_n(aa_pixels.begin() + offset, 3u, val);
+    }
+  }
+  const std::vector<uint8_t> original_aa_pixels = aa_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(aa_pixels), width, height);
+  EXPECT_NE(aa_pixels, original_aa_pixels);
+
+  // 4. 重复调用相同 Session 保持幂等稳定
+  std::vector<uint8_t> repeated_pixels = original_aa_pixels;
+  NoisePixelsEdgeAware(token_hash, base::span<uint8_t>(repeated_pixels), width, height);
+  EXPECT_EQ(aa_pixels, repeated_pixels);
+
+  // 5. 跨 Session 产生不同指纹
+  std::vector<uint8_t> other_session_pixels = original_aa_pixels;
+  const auto other_session_hash = NoiseHash(token, "https://b.test");
+  NoisePixelsEdgeAware(other_session_hash, base::span<uint8_t>(other_session_pixels), width, height);
+  EXPECT_NE(aa_pixels, other_session_pixels);
+}
 TEST_F(NoiseHelperTest, NoisePixelsAllSameValue) {
   const int width = 100;
   const int height = 100;
