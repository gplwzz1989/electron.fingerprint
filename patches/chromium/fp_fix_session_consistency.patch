From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gaoyang <gaoyang@coozf.com>
Date: Tue, 6 Oct 2026 00:00:00 +0800
Subject: [PATCH] fp: preserve session API consistency

修复 Session 指纹配置对原生 API 语义的破坏：限制网页可见内存取值，统一
CSS 设备尺寸，保持 OfflineAudioContext 请求参数，避免空 Range 偏移，并
固定 Canvas 快照的颜色格式。Client Hints 仅覆盖 Chromium 品牌并保留
真实完整版本与 GREASE 品牌。

diff --git a/third_party/blink/renderer/core/canvas_interventions/canvas_interventions_helper.cc b/third_party/blink/renderer/core/canvas_interventions/canvas_interventions_helper.cc
index aa43a2994a6b3..7480010c7e14d 100644
--- a/third_party/blink/renderer/core/canvas_interventions/canvas_interventions_helper.cc
+++ b/third_party/blink/renderer/core/canvas_interventions/canvas_interventions_helper.cc
@@ -190 +190 @@ bool CanvasInterventionsHelper::MaybeNoiseSnapshot(
-      viz::ToClosestSkColorType(snapshot->GetSharedImageFormat()),
+      kRGBA_8888_SkColorType,

diff --git a/third_party/blink/renderer/core/css/media_values.cc b/third_party/blink/renderer/core/css/media_values.cc
index 7b16f7e47742b..b5ce2c49dd34f 100644
--- a/third_party/blink/renderer/core/css/media_values.cc
+++ b/third_party/blink/renderer/core/css/media_values.cc
@@ -6,0 +7,4 @@
+#include <optional>
+
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
@@ -37,0 +42,43 @@ namespace blink {
+namespace {
+
+struct FingerprintDeviceSizeOverride {
+  int width;
+  int height;
+};
+
+std::optional<FingerprintDeviceSizeOverride>
+GetFingerprintDeviceSizeOverride() {
+  static const std::optional<FingerprintDeviceSizeOverride> override_value =
+      []() -> std::optional<FingerprintDeviceSizeOverride> {
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch("fingerprint-config"))
+      return std::nullopt;
+
+    std::optional<base::Value> config = base::JSONReader::Read(
+        command_line->GetSwitchValueASCII("fingerprint-config"));
+    if (!config || !config->is_dict())
+      return std::nullopt;
+
+    const base::Value::Dict& root = config->GetDict();
+    const base::Value::Dict* modules = root.FindDict("modules");
+    const base::Value::Dict* screen = root.FindDict("screen");
+    if (!root.FindBool("enabled").value_or(false) ||
+        !modules || !modules->FindBool("screen").value_or(false) ||
+        !screen) {
+      return std::nullopt;
+    }
+
+    const std::optional<int> width = screen->FindInt("width");
+    const std::optional<int> height = screen->FindInt("height");
+    if (!width || !height || *width < 1 || *height < 1)
+      return std::nullopt;
+
+    return FingerprintDeviceSizeOverride{*width, *height};
+  }();
+
+  return override_value;
+}
+
+}  // namespace
+
@@ -169,0 +217,3 @@ int MediaValues::CalculateDeviceWidth(LocalFrame* frame) {
+  if (const auto screen = GetFingerprintDeviceSizeOverride())
+    return screen->width;
+
@@ -187,0 +238,3 @@ int MediaValues::CalculateDeviceHeight(LocalFrame* frame) {
+  if (const auto screen = GetFingerprintDeviceSizeOverride())
+    return screen->height;
+
