+                          *device_memory != 4 && *device_memory != 8))

diff --git a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
index e9c1ee6d35ada..e8a2ef96180b1 100644
--- a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
+++ b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
@@ -31,0 +32 @@
+#include "base/containers/span.h"
@@ -42,0 +44 @@
+#include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
@@ -58 +60 @@ namespace {
-std::optional<float> GetFingerprintAudioSampleRateNoise() {
+std::optional<float> GetFingerprintAudioNoise() {
@@ -90 +92 @@ std::optional<float> GetFingerprintAudioSampleRateNoise() {
-        return static_cast<float>(normalized * 0.02);
+        return static_cast<float>(normalized * 0.00001);
@@ -183,7 +184,0 @@ OfflineAudioContext::OfflineAudioContext(LocalDOMWindow* window,
-  float adjusted_sample_rate = sample_rate;
-  if (const auto sample_rate_noise = GetFingerprintAudioSampleRateNoise()) {
-    adjusted_sample_rate = std::clamp(
-        sample_rate + *sample_rate_noise,
-        audio_utilities::MinAudioBufferSampleRate(),
-        audio_utilities::MaxAudioBufferSampleRate());
-  }
@@ -191 +186 @@ OfflineAudioContext::OfflineAudioContext(LocalDOMWindow* window,
-      this, number_of_channels, number_of_frames, adjusted_sample_rate);
+      this, number_of_channels, number_of_frames, sample_rate);
@@ -430,0 +426,13 @@ void OfflineAudioContext::FireCompletionEvent() {
+    if (const auto audio_noise = GetFingerprintAudioNoise()) {
+      for (unsigned channel = 0; channel < rendered_buffer->numberOfChannels();
+           ++channel) {
+        if (NotShared<DOMFloat32Array> channel_data =
+                rendered_buffer->getChannelData(channel)) {
+          base::span<float> samples = channel_data->AsSpan();
+          for (float& sample : samples) {
+            sample = std::clamp(sample + *audio_noise, -1.0f, 1.0f);
+          }
+        }
+      }
+    }
+
diff --git a/electron/shell/browser/fingerprint/fingerprint_profile_parser.cc b/electron/shell/browser/fingerprint/fingerprint_profile_parser.cc
index a0f78ffc00..15cca6f9f1 100644
--- a/electron/shell/browser/fingerprint/fingerprint_profile_parser.cc
