@@ -184,6 +188,47 @@ unsigned WebGLRenderingContextBase::max_active_webgl_contexts_on_worker_ = 0;
 
 namespace {
 
+struct FingerprintWebGLOverride {
+  String vendor;
+  String renderer;
+};
+
+std::optional<FingerprintWebGLOverride> GetFingerprintWebGLOverride() {
+  static const std::optional<FingerprintWebGLOverride> override_value =
+      []() -> std::optional<FingerprintWebGLOverride> {
+    const base::CommandLine* command_line =
+        base::CommandLine::ForCurrentProcess();
+    if (!command_line->HasSwitch("fingerprint-config"))
+      return std::nullopt;
+
+    std::optional<base::Value> config = base::JSONReader::Read(
+        command_line->GetSwitchValueASCII("fingerprint-config"));
+    if (!config || !config->is_dict())
+      return std::nullopt;
+
+    const base::Value::Dict& root = config->GetDict();
+    if (!root.FindBool("enabled").value_or(false))
+      return std::nullopt;
+
+    const base::Value::Dict* modules = root.FindDict("modules");
+    const base::Value::Dict* graphics = root.FindDict("graphics");
+    if (!modules || !modules->FindBool("webgl").value_or(false) ||
+        !graphics) {
+      return std::nullopt;
+    }
+
+    const std::string* vendor = graphics->FindString("webglVendor");
+    const std::string* renderer = graphics->FindString("webglRenderer");
+    if (!vendor || vendor->empty() || !renderer || renderer->empty())
+      return std::nullopt;
+
+    return FingerprintWebGLOverride{String::FromUTF8(*vendor),
+                                    String::FromUTF8(*renderer)};
+  }();
+
+  return override_value;
+}
