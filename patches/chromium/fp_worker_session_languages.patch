From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] fp: preserve session worker language lists

diff --git a/third_party/blink/renderer/core/workers/worker_navigator.cc b/third_party/blink/renderer/core/workers/worker_navigator.cc
index db1a55d008e76..7bcfaa4b152e7 100644
--- a/third_party/blink/renderer/core/workers/worker_navigator.cc
+++ b/third_party/blink/renderer/core/workers/worker_navigator.cc
@@ -25,6 +25,10 @@
  */
 
 #include "third_party/blink/renderer/core/workers/worker_navigator.h"
+
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
 #include "third_party/blink/public/platform/web_worker_fetch_context.h"
 #include "third_party/blink/renderer/core/dom/events/event.h"
 #include "third_party/blink/renderer/core/dom/events/event_target.h"
@@ -50,6 +54,35 @@ String WorkerNavigator::GetAcceptLanguages() {
     return "";
   }
 
+  // Renderer 配置启动后不可变；缓存标准字符串，避免跨线程共享 Blink 字符串。
+  static const base::NoDestructor<std::string> fingerprint_languages([] {
+    auto config = base::JSONReader::Read(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "fingerprint-config"));
+    if (!config || !config->is_dict())
+      return std::string();
+    const auto& root = config->GetDict();
+    const auto* modules = root.FindDict("modules");
+    const auto* locale = root.FindDict("locale");
+    if (!root.FindBool("enabled").value_or(false) || !modules || !locale ||
+        !modules->FindBool("locale").value_or(false)) {
+      return std::string();
+    }
+    const auto* languages = locale->FindList("languages");
+    if (!languages || languages->empty())
+      return std::string();
+    std::string result;
+    for (const auto& language : *languages) {
+      if (!language.is_string() || language.GetString().empty())
+        return std::string();
+      if (!result.empty())
+        result += ",";
+      result += language.GetString();
+    }
+    return result;
+  }());
+  if (!fingerprint_languages->empty())
+    return String::FromUTF8(*fingerprint_languages);
   return global_scope->GetAcceptLanguages();
 }
 
