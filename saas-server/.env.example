# 复制为 .env.dev、.env.test 或 .env.prod；支付密钥仅由服务端读取。
# 以下业务字段仅用于已有配置的首次数据库迁移；新生产部署使用 deploy/production.env.example，后续在系统管理后台维护。
# 监听地址：同机反向代理用 127.0.0.1；容器或远程代理按需用 0.0.0.0。
HOST=127.0.0.1
# 监听端口：优先于进程环境变量 PORT，未设置时用环境变量或默认 8088；反向代理转发到此端口。
PORT=8088
# 生产环境 .env.prod 设置为 https://qijie.xinmeitool.com。
# 公开页面地址：生产为 https://qijie.xinmeitool.com，不带路径、查询参数。
SAAS_PUBLIC_URL=http://127.0.0.1:8088
# 必填：MySQL 服务器地址，不包含协议和端口。
DB_HOST=
# 必填：MySQL 端口，通常为 3306。
DB_PORT=3306
# 必填：数据库账号；启动会创建数据库及表，需有对应权限。
DB_USER=
# 必填：数据库密码；配置文件仅供服务端读取，禁止放入公开目录。
DB_PASSWORD=
# 必填：数据库名称，仅支持英文字母、数字及下划线。
DB_NAME=qijie_workspace
# 持久化目录：留空使用 saas-server/data/workspace；生产建议绝对路径，必须备份 encryption.key。
SAAS_DATA_DIR=
# 仅页面验收脚本使用；留空时使用本项目 dist/browser-acceptance。
# 仅验收脚本使用，生产留空。
SAAS_ACCEPTANCE_DIR=
# 是否允许内网代理地址：生产默认 false，确有内网代理需求再开启。
SAAS_ALLOW_PRIVATE_PROXY=false
# 平台授权模块入口：默认使用包内模块；也支持相对于 saas-server 目录的路径或外部绝对路径。
FP_EXTERNAL_SERVICE_ENTRY=platform-service/server/index.cjs
# 客户端更新公开目录，仅存放已签名清单及安装包；私钥必须放在此目录之外。
# 可选：签名更新清单和安装包目录，相对于本配置文件；生产清单 prod-win32-x64.json，下载文件置于同目录。
CLIENT_UPDATES_DIR=client-updates
# QQ 邮箱发送验证码；SMTP_PASSWORD 填邮箱 SMTP 授权码，不填邮箱登录密码。
# 邮件服务器：QQ 邮箱默认 smtp.qq.com；未配置可用邮件服务时无法正常发送注册验证码。
SMTP_HOST=smtp.qq.com
# 邮件端口：SSL 通常 465，STARTTLS 通常 587。
SMTP_PORT=465
# 是否使用直接 TLS：465 填 true，587 通常填 false。
SMTP_SECURE=true
# 注册邮件必填：SMTP 登录邮箱。
SMTP_USER=
# 注册邮件必填：邮箱 SMTP 授权码或服务商凭据，不填邮箱网页登录密码。
SMTP_PASSWORD=
# 发件邮箱：通常与 SMTP_USER 一致，留空使用 SMTP_USER。
SMTP_FROM=
# 仅本机隔离邮件验收允许开启，生产环境保持 false。
# 仅隔离测试使用，生产必须保持 false。
SMTP_ALLOW_INSECURE_LOCAL=false
# 微信支付：正式商户配置完成并通过支付验收后开放。
# 支付总开关：完成真实商户配置及验收后才能改为 true；当前默认关闭。
PAYMENTS_ENABLED=false
# 套餐文件路径相对于当前环境配置文件；不配置时不提供任何在售套餐。
# 可选：真实套餐 JSON 文件路径，相对于本配置文件；留空不提供在售套餐，字段规范见部署说明。
BILLING_PLANS_FILE=
# 启用微信支付必填：绑定商户的应用 ID。
WECHAT_PAY_APP_ID=
# 启用微信支付必填：商户号。
WECHAT_PAY_MCH_ID=
# 启用微信支付必填：32 字节 API v3 密钥。
WECHAT_PAY_API_V3_KEY=
# 启用微信支付必填：商户 API 证书序列号，十六进制。
WECHAT_PAY_SERIAL_NO=
# 启用微信支付必填：商户私钥文件绝对路径，文件在部署服务器单独提供。
WECHAT_PAY_PRIVATE_KEY_PATH=
# 启用微信支付必填：微信平台证书或平台公钥文件绝对路径。
WECHAT_PAY_PLATFORM_CERT_PATH=
# 使用微信支付平台公钥时填写 PUB_KEY_ID_*；使用平台证书时自动读取序列号。
# 使用平台公钥必填 PUB_KEY_ID_*；使用平台证书时自动读取，可留空。
WECHAT_PAY_PLATFORM_SERIAL_NO=
# 微信支付回调公网 HTTPS 地址：生产 https://qijie.xinmeitool.com/api/payments/wechat/notify。
WECHAT_PAY_NOTIFY_URL=https://qijie.xinmeitool.com/api/payments/wechat/notify
# 支付宝：国际支付后续通过服务端支付提供方接口扩展。
# 启用支付宝必填：正式应用 ID。
ALIPAY_APP_ID=
# 启用支付宝必填：收款卖家 ID。
ALIPAY_SELLER_ID=
# 支付宝沙箱开关：生产必须为 false。
ALIPAY_SANDBOX=false
# 启用支付宝必填：应用私钥文件绝对路径。
ALIPAY_PRIVATE_KEY_PATH=
# 启用支付宝必填：支付宝公钥文件绝对路径。
ALIPAY_PUBLIC_KEY_PATH=
# 支付宝回调公网 HTTPS 地址：生产 https://qijie.xinmeitool.com/api/payments/alipay/notify。
ALIPAY_NOTIFY_URL=https://qijie.xinmeitool.com/api/payments/alipay/notify

# 平台授权脚本和身份核验模块随生产包提供，升级时应与主程序一起替换。
