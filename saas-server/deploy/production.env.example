# 生产启动配置；业务参数在 /system-admin.html 后台配置并加密保存到数据库。
# 同机反向代理使用 127.0.0.1；容器或远程代理按需使用 0.0.0.0。
HOST=127.0.0.1
# 配置文件端口优先于进程环境变量 PORT。
PORT=8710
# MySQL 地址、端口、账号、密码和库名；请填写真实凭据。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=qijie_workspace
# 留空使用 saas-server/data/workspace，必须持久保存并备份其中的 encryption.key。
SAAS_DATA_DIR=
# 首次初始化的公开地址；初始化完成后通过后台维护。
SAAS_PUBLIC_URL=https://qijie.xinmeitool.com
# 平台脚本随包提供；此处是部署模块位置，不允许从网页下载执行脚本。
FP_EXTERNAL_SERVICE_ENTRY=platform-service/server/index.cjs
