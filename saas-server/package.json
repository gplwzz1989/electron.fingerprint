{
  "name": "@qijie/saas-server",
  "version": "0.3.18",
  "description": "栖界指纹浏览器云端协同中枢服务 (SaaS Server)",
  "main": "src/workspace-server.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.cjs",
    "start": "npm run prisma:generate && node scripts/prisma-cli.cjs db push && node src/workspace-server.js",
    "watch": "npm run prisma:generate && node scripts/prisma-cli.cjs db push && node --watch src/workspace-server.js",
    "prisma:format": "node scripts/prisma-cli.cjs format",
    "prisma:generate": "node scripts/prisma-cli.cjs generate",
    "prisma:validate": "node scripts/prisma-cli.cjs validate",
    "prisma:sync": "node scripts/prisma-cli.cjs db push",
    "prisma:prepare-linux-engine": "node scripts/prepare-prisma-engines.cjs",
    "test": "node --test test/resource-deletion.test.js test/client-authorization.test.js test/system-settings.test.js test/desktop-sdk.test.js test/account-launch.test.js test/project-boundary.test.js test/workspace.test.js test/media-authorizations.test.js test/media-authorization-ui.test.js test/registration.test.js test/billing.test.js",
    "package:source": "pwsh -NoProfile -File scripts/package-source.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "nodemailer": "10.2.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@prisma/fetch-engine": "6.19.3",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@vercel/ncc": "0.45.0",
    "esbuild": "0.25.5",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
